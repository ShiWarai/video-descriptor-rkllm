# Скопируйте в .env и отредактируйте под свою среду:
#   cp .env.example .env
#
# Файл .env в .gitignore и .dockerignore — в git/образ не попадает.
# Секреты храните только здесь (или в secrets менеджере), не в config.json.

# whisper-rknn / hwdsl2/whisper-server URL (пусто = stub ASR без транскрипции).
# OpenAI-совместимый API: POST /v1/audio/transcriptions (NPU и CPU образы).
# http:// — только доверенная LAN/docker-сеть (ключ и аудио без TLS).
# https:// — для доступа через интернет / reverse proxy.
# Примеры:
#   WHISPER_RKNN_URL=http://10.0.0.23:8080
#   WHISPER_RKNN_URL=http://whisper-rknn-api:9003
#   WHISPER_RKNN_URL=https://whisper.example.com
WHISPER_RKNN_URL=

# Bearer для POST /v1/audio/transcriptions (должен совпадать с WHISPER_API_KEY на стороне whisper).
# Пусто = без auth (только если whisper тоже без ключа).
WHISPER_API_KEY=

# Автоподгрузка моделей VLM: 0 | 0.8b | 2b | 4b | all
VLM_DOWNLOAD_MODELS=0

# Свои URL весов: имя_файла=https://...
VLM_MODEL_URLS=

# Логи API (1 = подробные)
VLM_VERBOSE=1

# API key для /v1/* (OpenAI-style: Authorization: Bearer <key>). Пусто = без авторизации.
VLM_API_KEY=

# RK3588: зафиксировать NPU/CPU/LPDDR4 на максимум при старте контейнера
VLM_FIX_FREQ=1
# Дополнительно зафиксировать Mali GPU
VLM_FIX_GPU_FREQ=1
